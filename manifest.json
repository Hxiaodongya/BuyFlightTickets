{
  "manifest_version": 3,
  "name": "航班价格追踪",
  "version": "0.1.0",
  "description": "在本地记录国航、南航和长龙航空的公开航班列表价变化。",
  "icons": {
    "16": "icons/flight-tracker-16.png",
    "32": "icons/flight-tracker-32.png",
    "48": "icons/flight-tracker-48.png",
    "128": "icons/flight-tracker-128.png"
  },
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "航班价格追踪",
    "default_icon": {
      "16": "icons/flight-tracker-16.png",
      "32": "icons/flight-tracker-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.airchina.com.cn/flight/oneway/*",
        "https://b2c.csair.com/B2C40/newTrips/static/main/page/booking/index.html*"
      ],
      "js": [
        "src/collectors/price-parser.js",
        "src/collectors/result-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.loongair.cn/?flightTrackerFrom=*"],
      "js": [
        "src/collectors/price-parser.js",
        "src/collectors/loong-air-page.js",
        "src/collectors/result-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
